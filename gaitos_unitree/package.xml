<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gaitos_unitree</name>
  <version>0.1.0</version>
  <description>Unitree backends of gaitos through unitree_sdk2 (Go2: unitree_go, R1: unitree_hg), launch files of the real robots and a headless DDS Go2 simulator.</description>
  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gaitos_core</depend>
  <!-- unitree_sdk2 (not a ROS package) is fetched by CMake FetchContent -->
  <build_depend>git</build_depend>
  <exec_depend>gaitos_system</exec_depend>
  <exec_depend>gaitos_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>joy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
