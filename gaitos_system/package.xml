<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gaitos_system</name>
  <version>0.1.0</version>
  <description>The gaitos system: robot cycle (hardware, sensors, estimator, modes, controllers, actuators), safety and the gaitos lifecycle node.</description>
  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gaitos_core</depend>
  <depend>gaitos_modes</depend>
  <depend>gaitos_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>rosgraph_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pluginlib</depend>
  <exec_depend>gaitos_actuators</exec_depend>
  <exec_depend>gaitos_sensors</exec_depend>
  <exec_depend>gaitos_estimators</exec_depend>
  <exec_depend>gaitos_controllers</exec_depend>
  <exec_depend>gaitos_dynamics</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gaitos_hardware</test_depend>
  <test_depend>gaitos_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
