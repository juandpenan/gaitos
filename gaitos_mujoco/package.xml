<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gaitos_mujoco</name>
  <version>0.1.0</version>
  <description>MuJoCo backend of gaitos (in process, lockstep simulation) and the offscreen snapshot tool; renderer extension (simulated cameras, viewer window).</description>
  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gaitos_core</depend>
  <depend>gaitos_system</depend>
  <depend>zlib</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>libglfw3-dev</depend>
  <!-- MuJoCo 3 from the system (libmujoco-dev; no rosdep key) and EGL for the snapshot tool -->
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gaitos_description</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
