<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gaitos_naoqi_sim</name>
  <version>0.1.0</version>
  <description>The ROS 2 interface of naoqi_driver (joint_states, odom, imu, cmd_vel, joint_angles, moveTo) in front of a simulated gaitos NAO, so programs written for the real NAO run against MuJoCo or Gazebo.</description>
  <maintainer email="juanscelyg@gmail.com">Juan S. Cely G.</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>gaitos_system</depend>
  <depend>geometry_msgs</depend>
  <depend>naoqi_bridge_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>gaitos_mujoco</exec_depend>
  <exec_depend>gaitos_gazebo</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>gaitos_hardware</test_depend>
  <test_depend>gaitos_description</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
